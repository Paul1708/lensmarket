# Copy this file to .env and replace every replace-* value before starting the stack.
# Values in this example are deliberately non-functional placeholders, not credentials.
COMPOSE_PROJECT_NAME=cc_lensmarket
POSTGRES_USER=lensmarket
POSTGRES_PASSWORD=replace-with-random-postgres-password
LENSMARKET_JWT_SECRET=replace-with-at-least-32-random-bytes
LENSMARKET_JWT_ISSUER=lensmarket-auth
LENSMARKET_JWT_AUDIENCE=lensmarket-services
LENSMARKET_TOKEN_TTL_SECONDS=7200
# Operational tuning; the defaults are suitable for the local acceptance stack.
LENSMARKET_HTTP_CONNECT_TIMEOUT_MS=1000
LENSMARKET_HTTP_REQUEST_TIMEOUT_MS=2000
LENSMARKET_OUTBOX_RELAY_INTERVAL=1s
LENSMARKET_OUTBOX_BATCH_SIZE=50
LENSMARKET_ORPHAN_SCAN_INTERVAL=1m
MINIO_ROOT_USER=lensmarket
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
TRAEFIK_DASHBOARD_USERS=admin:replace-with-bcrypt-htpasswd-entry
