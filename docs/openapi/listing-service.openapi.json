    "schemas" : {
      "ApiErrorResponse" : {
        "type" : "object",
        "required" : [ "error", "message", "status", "path" ],
        "properties" : {
          "error" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "ChangeListingStatusRequest" : {
        "type" : "object",
        "required" : [ "status" ],
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "PAUSED", "SOLD" ]
          }
        }
      },
      "CreateListingRequest" : {
        "type" : "object",
        "required" : [ "title", "description" ],
        "properties" : {
          "title" : {
            "type" : "string",
            "minLength" : 1
          },
          "description" : {
            "type" : "string",
            "minLength" : 1
          },
          "priceHint" : {
            "type" : [ "number", "null" ],
            "minimum" : 0
          },
          "location" : {
            "type" : [ "string", "null" ]
          },
          "cameraModel" : {
            "type" : [ "string", "null" ]
          },
          "lensModel" : {
            "type" : [ "string", "null" ]
          },
          "tags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "ListingResponse" : {
        "type" : "object",
        "required" : [ "id", "ownerUserId", "title", "description", "priceHint", "location", "cameraModel", "lensModel", "tags", "imageIds", "status", "createdAt" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "ownerUserId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "priceHint" : {
            "type" : [ "number", "null" ],
            "minimum" : 0
          },
          "location" : {
            "type" : [ "string", "null" ]
          },
          "cameraModel" : {
            "type" : [ "string", "null" ]
          },
          "lensModel" : {
            "type" : [ "string", "null" ]
          },
          "tags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "imageIds" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "readOnly" : true
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "PAUSED", "SOLD" ]
          },
          "createdAt" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "PatchListingRequest" : {
        "minProperties" : 1,
        "description" : "Mindestens eines der Felder muss vorhanden sein.",
