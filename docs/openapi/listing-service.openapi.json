        "properties" : {
          "title" : {
            "type" : [ "string", "null" ],
            "minLength" : 1
          },
          "description" : {
            "type" : [ "string", "null" ],
            "minLength" : 1
          },
          "priceHint" : {
            "type" : [ "number", "null" ],
            "minimum" : 0
