            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Anzeige, Konversation oder Nachrichtengrundlage nicht gefunden",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500" : {
            "description" : "Unerwarteter interner Fehler",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "tags" : [ "Messaging Resource" ]
      },
      "get" : {
        "summary" : "Nachrichten einer eigenen Konversation lesen",
        "parameters" : [ {
          "name" : "conversationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Standard 100",
          "required" : false,
          "name" : "limit",
          "in" : "query",
          "schema" : {
