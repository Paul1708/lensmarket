{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Wasserzeichen-Bildupload, Metadaten und Auslieferung. Öffentliche Lesewege liefern ausschließlich WATERMARKED-Bilder.",
    "title" : "LensMarket Image Service API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8081",
    "description" : "Lokaler Traefik-Gateway"
  } ],
  "components" : {
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    },
    "schemas" : {
      "ApiErrorResponse" : {
        "type" : "object",
        "required" : [ "error", "message", "status", "path" ],
        "properties" : {
          "error" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "ChangeImageStatusRequest" : {
        "type" : "object",
        "required" : [ "status" ],
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "WATERMARKED", "ARCHIVED" ]
          }
        }
      },
      "ImageResponse" : {
        "type" : "object",
        "required" : [ "id", "listingId", "ownerUserId", "originalFileName", "mimeType", "width", "height", "status", "watermarkedUrl", "hasFile", "createdAt" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "listingId" : {
            "type" : "string"
          },
          "ownerUserId" : {
            "type" : "string"
          },
          "originalFileName" : {
            "type" : "string"
          },
          "mimeType" : {
            "type" : "string",
            "enum" : [ "image/jpeg", "image/png" ]
          },
          "width" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "minimum" : 1
          },
          "height" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "minimum" : 1
          },
          "status" : {
            "type" : "string",
            "enum" : [ "WATERMARKED", "ARCHIVED" ]
          },
          "watermarkedUrl" : {
            "type" : "string",
            "examples" : [ "/images/7d6d987f/watermarked" ]
          },
          "hasFile" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      }
    }
  },
  "paths" : {
    "/images" : {
      "get" : {
        "summary" : "Öffentliche WATERMARKED-Bilder filtern",
        "parameters" : [ {
          "required" : false,
          "name" : "listingId",
          "in" : "query",
          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
          "required" : false,
          "name" : "ownerUserId",
          "in" : "query",
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Bildmetadatenliste",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ImageResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Validierungsfehler, ungültiger Bildinhalt, MIME-Type oder Status",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500" : {
            "description" : "Unerwarteter interner Fehler",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "tags" : [ "Image Resource" ]
      }
    },
